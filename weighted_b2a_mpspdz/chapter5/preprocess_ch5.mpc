# Hybrid preprocessing: BDOZ is attached by a TRUSTED local process after MPC.
# Real malicious-secure arithmetic MPC preprocessing for Figures 7--9.
# Compile: compile.py -P Q preprocess_ch5 <degree_csv> <d-T> <d0>
# No CRT shares or secrets are inputs. Each output is private to its owner.
from Compiler.types import sint
from Compiler.library import print_ln_to, check_point, start_timer, stop_timer

DEGREES = list(map(int, program.args[1].split(',')))
H, D0 = map(int, program.args[2:4])
N = len(DEGREES)
Q = int(program.options.prime)
if N < 2 or H < 0 or D0 < (Q-1).bit_length() or Q <= 65536:
    raise ValueError('Invalid dimensions or field')
# Pack at most 32 bits per field element, strictly below Q.
CHUNK = min(32, Q.bit_length()-1)

def emit(i, label, value):
    print_ln_to(i, label + '=%s', value.reveal_to(i))

def emit128(i, label, bits):
    for off in range(0, 128, CHUNK):
        emit(i, label + '_' + str(off), sum((2**k)*bits[off+k] for k in range(min(CHUNK,128-off))))

def xor(a,b):
    return a+b-2*a*b

start_timer(10)
alpha = [sint.get_random() for i in range(N)]
alpha_sum = sum(alpha)
for i in range(N):
    emit(i, 'ALPHA', alpha[i])
check_point()
stop_timer(10)


start_timer(11)
# Random authenticated input masks. Figure 8 setup later opens s_i XOR r_i.
for i,d in enumerate(DEGREES):
    bits = [sint.get_random_bit() for k in range(d)]
    for k,b in enumerate(bits):
        emit(i,'R_B_%s'%k,b)
check_point()
stop_timer(11)

def dabits(kind, length):
    # Build the F_daBits output distribution inside MASCOT. Random XOR
    # shares determine b; independent additive sharings represent b and alpha*b.
    b = [[sint.get_random_bit() for k in range(length)] for i in range(N)]
    for i in range(N):
        for k in range(length):
            emit(i,'%s_B_%s'%(kind,k), b[i][k])
    for k in range(length):
        bit = b[0][k]
        for i in range(1,N):
            bit = xor(bit,b[i][k])
        a = [sint.get_random() for i in range(N-1)]
        a.append(bit-sum(a))
        g = [sint.get_random() for i in range(N-1)]
        g.append(alpha_sum*bit-sum(g))
        for i in range(N):
            emit(i,'%s_A_%s'%(kind,k),a[i])
            emit(i,'%s_G_%s'%(kind,k),g[i])

start_timer(12)
dabits('Z',H)  # Consumed by Figure 7, never reused for Figure 9.
check_point()
stop_timer(12)
start_timer(13)
dabits('B',D0)
check_point()
stop_timer(13)
# Ensure all checks including private output openings finish before publishing files.
check_point()
